		workflow
		{
		form
		{
			On_Claim_Submit_Workflow as "On_Claim_Submit_Workflow"
			{
				type =  form
				form = Claim_Request_Form

				record event = on add

				on success
				{
					actions 
					{
						sendmail
						(
							from : "zoho.adminuserid"
							to : Email_Address
							subject : "Your Record Added"
							message : "<div>Hello ${Claimant_Name},<br></div><div><br></div><div>Your form has been recorded.</div>"
							attachments : template : _default1 as inline
						)
					}
				}

			}
		}

		schedule
		{
			Daily_Missing_Document_Re as "Daily_Missing_Document_Reminder_Schedule"
			{
				type =  schedule
				start = "2026-08-21 10:00:00"
				frequency = daily
				time zone = "Asia/Kolkata"
				on start
				{
					actions 
					{
					on load
					(
						email = Claim_Request_Form[Supporting_Documents_Available == ""].Email_Address;
										sendmail
										[
											from :zoho.adminuser
											to :email
											subject :"Upload the supporting documents."
											message :"<div><br></div>"
										]
					)
					}
				}
			}
		}

		approval
		{
			HighValue_Claim_Approval as "HighValue_Claim_Approval"
			{
				type =  approval
				form = Claim_Request_Form
				display fields = [Claimant_Name,Claimant_Type,Policy_Number,Email_Address,Contact_Number,Residential_Address,Claim_Type]
				on start
				{
				}
				on level 1
				{
					approvers
					(
			 			role = "CEO"
					)
					on approve 
					{
						actions 
						{
							sendmail
							(
								from : zoho.loginuserid
								to : approver.submitter
								subject : "Approval Request"
								message : "Your request has been approved."
							)
						}
					}
					on reject
					{

						actions 
						{
							sendmail
							(
								from : zoho.loginuserid
								to : approver.submitter
								subject : "Approval Request"
								message : "Your request has been rejected."
							)
						}
					}
				}
			}
		}

