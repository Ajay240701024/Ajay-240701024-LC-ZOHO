 * Author       : aswinsiddharth.a.2024.cse118
 * Generated on : 21-Aug-2026 16:32:19
 * Version      : 1.0
 */
 application "Insurance Claim Request & Processing Management"
 {
 	date format = "dd-MMM-yyyy"
 	time zone = "Asia/Kolkata"
 	time format = "24-hr"

 	forms
	{
		form Claim_Request_Form
		{
			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Claimant_Details
			(
				type = section
				displayname = "Claimant Details"
				visibility = true
	 			row = 2
	 			column = 0   
				width = medium
			)
			must have Claimant_Name
			(
    			type = name
     			prefix
     			(
	     			 type = prefix
	     			 displayname ="Prefix"
	     			 visibility = false
	     			 value = {"Mr.","Mrs.","Ms."}
     			) 
     			first_name
     			(
	     			 type = first_name
	     			 displayname ="First Name"
     			) 
     			last_name
     			(
	     			 type = last_name
	     			 displayname ="Last Name"
     			) 
     			suffix
     			(
	     			 type = suffix
	     			 displayname ="Suffix"
	     			 visibility = false
     			) 
	 			row = 2
	 			column = 1   
				width = medium
				personal data = true
			)
			Claimant_Type
			(
				type = radiobuttons
				maxchar = 100
				values = {"Choice 1","Choice 2","Choice 3"}
	 			row = 2
	 			column = 1   
				width = medium
			)
			must have Policy_Number
			(
    			type = text
	 			row = 2
	 			column = 1   
				width = medium
			)
			Contact_Details
			(
				type = section
				displayname = "Contact Details"
				visibility = true
	 			row = 3
	 			column = 0   
				width = medium
			)
			Email_Address
			(
    			type = email
				maxchar = 80
	 			row = 3
	 			column = 1   
				width = medium
				personal data = true
			)
			must have Contact_Number
			(
    			type = phonenumber
	 			row = 3
	 			column = 1   
				width = medium
				personal data = true
			)
			Residential_Address
			(
    			type = address
     			capture_coordinates = true
     			adjust_using_map = false
     			address_line_1
     			(
	     			  type = address_line_1
	     			  displayname = "Address Line 1"
     			) 
     			address_line_2
     			(
	     			  type = address_line_2
	     			  displayname = "Address Line 2"
     			) 
     			district_city
     			(
	     			  type = district_city
	     			  displayname = "City / District"
     			) 
     			state_province
     			(
	     			  type = state_province
	     			  displayname = "State / Province"
     			) 
     			postal_Code
     			(
	     			  type = postal_Code
	     			  displayname = "Postal Code"
     			) 
     			country
     			(
	     			  type = country
	     			  displayname = "Country"
     			) 
     			latitude
     			(
	     			  type = latitude
	     			  displayname = "latitude"
	     			 visibility = false
     			) 
     			longitude
     			(
	     			  type = longitude
	     			  displayname = "longitude"
	     			 visibility = false
     			) 
	 			row = 3
	 			column = 1   
				width = medium
				personal data = true
			)
			Claim_Details
			(
				type = section
				displayname = "Claim Details"
				visibility = true
	 			row = 4
	 			column = 0   
				width = medium
			)
			must have Claim_Type
			(
				type = picklist
				maxchar = 100
				values = {"Choice 1","Choice 2","Choice 3"}
	 			row = 4
	 			column = 1   
				width = medium
			)
			must have Date_Of_Incident
			(
    			type = date
				alloweddays = 0,1,2,3,4,5,6
	 			row = 4
	 			column = 1   
				width = medium
			)
			must have Claim_Amount_Requested
			(
				type = number
	 			row = 4
	 			column = 1   
				width = medium
			)
			Supporting_Documents_Available
			(
				type = list	
				values = {"Choice 1","Choice 2","Choice 3"}
				height = 60px
	 			row = 4
	 			column = 1   
				width = medium
			)
			Incident_Description
			(
    			type = textarea
				height = 100px
	 			row = 4
	 			column = 1   
				width = medium
			)
			Scheduling_Declaration
			(
				type = section
				displayname = "Scheduling & Declaration"
				visibility = true
	 			row = 5
	 			column = 0   
				width = medium
			)
			Preferred_Callback_Time
			(
    			type = time
				timedisplayoptions = "hh:mm:ss" 
	 			row = 5
	 			column = 1   
				width = medium
			)
			must have Declaration_Of_Authenticity
			(
				type = checkboxes	
				values = {"agree"}
	 			row = 5
	 			column = 1   
				width = medium
			)
			Policy_Verification_Evidence
			(
				type = section
				displayname = "Policy Verification & Evidence"
				visibility = true
	 			row = 6
	 			column = 0   
				width = medium
			)
			Policy_Details_Lookup
			(
				type = picklist	
				values  = Claim_Request_Form.ID
    			displayformat = [Policy_Number]
				sortorder = ascending
	 			row = 6
	 			column = 1   
				width = medium
			)
			Damage_Photo
			(
    			type = image
				source  = file
				aspect ratio = original
				camera = primary
				show gallery = true
				switch camera = true
	 			row = 6
	 			column = 1   
				width = medium
			)
			Repair_Estimate_Upload
			(
    			type = upload file
				browse = local_drive
	 			row = 6
	 			column = 1   
				width = medium
			)
			Policy_Sum_Insured_Lakhs
			(
				type = decimal
	 			row = 6
	 			column = 1   
				width = medium
			)
			Witness_Media_Details
			(
				type = section
				displayname = "Witness & Media Details"
				visibility = true
	 			row = 7
	 			column = 0   
				width = medium
			)
			FIR_Copy_Online_Link
			(
    			type = url
				enable  linkname
	 			row = 7
	 			column = 1   
				width = medium
			)
			Accident_Scene_Video
			(
    			type = video
    			duration=30
	 			row = 7
	 			column = 1   
				width = medium
			)
			Incident_Voice_Statement
			(
     			type = audio
    			duration=60
	 			row = 7
	 			column = 1   
				width = medium
			)
			Witness_Details
			(
				type = grid
				Name
				(
    				type = name
     				prefix
     				(
	     				 type = prefix
	     				 displayname ="Prefix"
	     				 visibility = false
	     				 value = {"Mr.","Mrs.","Ms."}
     				) 
     				first_name
     				(
	     				 type = first_name
	     				 displayname ="First Name"
     				) 
     				last_name
     				(
	     				 type = last_name
	     				 displayname ="Last Name"
     				) 
     				suffix
     				(
	     				 type = suffix
	     				 displayname ="Suffix"
	     				 visibility = false
     				) 
					width = medium
					personal data = true
				)
	 			row = 8
	 			column = 1   
				width = medium
			)
			Settlement_Computation
			(
				type = section
				displayname = "Settlement Computation"
				visibility = true
	 			row = 9
	 			column = 0   
				width = medium
			)
			Is_Third_Party_Involved
			(
    			type = checkbox
				initial value = false
	 			row = 9
	 			column = 1   
				width = medium
			)
			Estimated_Repair_Cost
			(
				type = INR
				format = commadotindian
	 			row = 9
	 			column = 1   
				width = medium
			)
			Depreciation_Percent
			(
    			type = percentage
	 			row = 9
	 			column = 1   
				width = medium
			)
			Net_Payable_Amount
			(
				type = decimal
	 			row = 9
	 			column = 1   
				width = medium
    			Formula_Properties
    			(
    						value =  input.Estimated_Repair_Cost - input.Estimated_Repair_Cost * input.Depreciation_Percent + 10000
    						visibility = false
    			)
			)
			Declaration_System_Generated_Values
			(
				type = section
				displayname = "Declaration & System-Generated Values"
				visibility = true
	 			row = 10
	 			column = 0   
				width = medium
			)
			Claim_Process_Guidelines_Display
			(
    			type = richtext
				height = 200px
				toolbar = enable
				[
					style, font-color, background-color, link, bullets-and-numbering, 
					font-size : {1, 2, 3, 4, 5, 6, 7}
				]
    			description
    			[
    				type = tooltip
    			 	message = "Keep all original\nbills and estimates. A\nsurveyor will contact\nyou within 48 hours.\nDo not repair the\nvehicle before\ninspection."
    			]
	 			row = 10
	 			column = 1   
				width = medium
			)
			Claimant_Digital_Signature
			(
    			type = signature
	 			row = 10
	 			column = 1   
				width = medium
				personal data = true
			)
			Claim_Submitted_On
			(
    			type = datetime
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 10
	 			column = 1   
				width = medium
			)
			Claim_Reference_ID
			(
    			type = autonumber
				start index = 1
	 			row = 10
	 			column = 1   
				width = medium
			)
			QR_Code
			(
				type = qrcode
				displayname = "QR Code"
				value = "${Claim_Reference_ID}"
	 			row = 10
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
			blueprint components
			{
				stages = {"Submitted","Document Verification","Investigation","Approved","Settled","Rejected"}
			}
		}
	}
	reports
	{
		default list Claim_Request_Form_Report
		{
			displayName = "Claim_Request_Form Report"
			show all rows from Claim_Request_Form    
			(
				Claimant_Name 
				Email_Address
				Residential_Address 
	 			(
	      			enable = Link_to_Map,Show_As_Text
	 			)
				Contact_Number
				(
					displayformat = plainnumber 
				)
				Policy_Number
				Incident_Description
				Claim_Amount_Requested
				Date_Of_Incident
				Preferred_Callback_Time
				Claim_Type
				Claimant_Type
				Supporting_Documents_Available
				Declaration_Of_Authenticity
				Is_Third_Party_Involved
				Claim_Process_Guidelines_Display
				FIR_Copy_Online_Link
				Damage_Photo
				Depreciation_Percent
				Estimated_Repair_Cost
				Policy_Sum_Insured_Lakhs
				Claim_Submitted_On
				Witness_Details.Name as "Witness_Details"
				Policy_Details_Lookup
				Claimant_Digital_Signature
				Repair_Estimate_Upload
				Incident_Voice_Statement
				Accident_Scene_Video
				Claim_Reference_ID
				Net_Payable_Amount
				QR_Code as "QR Code"
			)
		}
		list All_Claims_List
		{
			displayName = "All_Claims_List"
			show all rows from Claim_Request_Form    
			(
				Claimant_Name 
				Claimant_Type
				Policy_Number
				Email_Address
				Contact_Number
				(
					displayformat = plainnumber 
				)
				Residential_Address 
	 			(
	      			enable = Link_to_Map,Show_As_Text
	 			)
				Claim_Type
				Date_Of_Incident
				Claim_Amount_Requested
				Supporting_Documents_Available
				Incident_Description
				Preferred_Callback_Time
				Declaration_Of_Authenticity
				Is_Third_Party_Involved
				Claim_Process_Guidelines_Display
				FIR_Copy_Online_Link
				Damage_Photo
				Depreciation_Percent
				Estimated_Repair_Cost
				Policy_Sum_Insured_Lakhs
				Claim_Submitted_On
				Policy_Details_Lookup
				Claimant_Digital_Signature
				Repair_Estimate_Upload
				Incident_Voice_Statement
				Accident_Scene_Video
				Claim_Reference_ID
				Net_Payable_Amount
				QR_Code as "QR Code"
			)
			group by
			(
				Date_Of_Incident descending
			)
		}
		spreadsheet Claims_Spreadsheet
		{
			displayName = "Claims_Spreadsheet"
			show all rows from Claim_Request_Form    
			(
				Claimant_Name 
				Claimant_Type
				Policy_Number
				Email_Address
				Contact_Number
				(
					displayformat = plainnumber 
				)
				Residential_Address 
	 			(
	      			enable = Link_to_Map,Show_As_Text
	 			)
				Claim_Type
				Date_Of_Incident
				Claim_Amount_Requested
				Supporting_Documents_Available
				Incident_Description
				Preferred_Callback_Time
				Declaration_Of_Authenticity
				Is_Third_Party_Involved
				Claim_Process_Guidelines_Display
				FIR_Copy_Online_Link
				Damage_Photo
				Depreciation_Percent
				Estimated_Repair_Cost
				Policy_Sum_Insured_Lakhs
				Claim_Submitted_On
				Policy_Details_Lookup
				Claimant_Digital_Signature
				Repair_Estimate_Upload
				Incident_Voice_Statement
				Accident_Scene_Video
				Claim_Reference_ID
				Net_Payable_Amount
				QR_Code as "QR Code"
			)
		}
		kanban Claim_Status_Kanban
		{
			displayName = "Claim_Status_Kanban"
			show all rows from Claim_Request_Form    
			(
				Claimant_Name 
				Claimant_Type
				Policy_Number
				Email_Address
				Contact_Number
				(
					displayformat = plainnumber 
				)
				Residential_Address 
	 			(
	      			enable = Link_to_Map,Show_As_Text
	 			)
				Claim_Type
				Date_Of_Incident
				Claim_Amount_Requested
				Supporting_Documents_Available
				Incident_Description
				Preferred_Callback_Time
				Declaration_Of_Authenticity
				Is_Third_Party_Involved
				Claim_Process_Guidelines_Display
				FIR_Copy_Online_Link
				Damage_Photo
				Depreciation_Percent
				Estimated_Repair_Cost
				Policy_Sum_Insured_Lakhs
				Claim_Submitted_On
				Policy_Details_Lookup
				Claimant_Digital_Signature
				Repair_Estimate_Upload
				Incident_Voice_Statement
				Accident_Scene_Video
				Claim_Reference_ID
				Net_Payable_Amount
				QR_Code as "QR Code"
			)
			options
			(
	 			display field = Claim_Type
	 		)
		}
		calendar Incident_Date_Calendar
		{
			displayName = "Incident_Date_Calendar"
			show all rows from Claim_Request_Form    
			(
				Claimant_Name 
				Claimant_Type
				Policy_Number
				Email_Address
				Contact_Number
				(
					displayformat = plainnumber 
				)
				Residential_Address 
	 			(
	      			enable = Link_to_Map,Show_As_Text
	 			)
				Claim_Type
				Date_Of_Incident
				Claim_Amount_Requested
				Supporting_Documents_Available
				Incident_Description
				Preferred_Callback_Time
				Declaration_Of_Authenticity
				Policy_Details_Lookup
				Damage_Photo
				Repair_Estimate_Upload
				Policy_Sum_Insured_Lakhs
				FIR_Copy_Online_Link
				Accident_Scene_Video
				Incident_Voice_Statement
				Is_Third_Party_Involved
				Estimated_Repair_Cost
				Depreciation_Percent
				Net_Payable_Amount
				Claim_Process_Guidelines_Display
				Claimant_Digital_Signature
				Claim_Submitted_On
				Claim_Reference_ID
				QR_Code as "QR Code"
			)
			options
			(
				display field = Date_Of_Incident
				start date = Date_Of_Incident
			)
		}
		map Claimant_Location_Map
		{
			displayName = "Claimant_Location_Map"
			show all rows from Claim_Request_Form    
			(
				Claimant_Name 
				Claimant_Type
				Policy_Number
				Email_Address
				Contact_Number
				(
					displayformat = plainnumber 
				)
				Residential_Address 
	 			(
	      			enable = Link_to_Map,Show_As_Text
	 			)
				Claim_Type
				Date_Of_Incident
				Claim_Amount_Requested
				Supporting_Documents_Available
				Incident_Description
				Preferred_Callback_Time
				Declaration_Of_Authenticity
				Policy_Details_Lookup
				Damage_Photo
				Repair_Estimate_Upload
				Policy_Sum_Insured_Lakhs
				FIR_Copy_Online_Link
				Accident_Scene_Video
				Incident_Voice_Statement
				Is_Third_Party_Involved
				Estimated_Repair_Cost
				Depreciation_Percent
				Net_Payable_Amount
				Claim_Process_Guidelines_Display
				Claimant_Digital_Signature
				Claim_Submitted_On
				Claim_Reference_ID
				QR_Code as "QR Code"
			)
			options
			(
	 			display field = Residential_Address
	 		)
		}
		timeline Claim_Activity_Timeline
		{
			displayName = "Claim_Activity_Timeline"
			show all rows from Claim_Request_Form    
			(
				Claimant_Name 
				Claimant_Type
				Policy_Number
				Email_Address
				Contact_Number
				(
					displayformat = plainnumber 
				)
				Residential_Address 
	 			(
	      			enable = Link_to_Map,Show_As_Text
	 			)
				Claim_Type
				Date_Of_Incident
				Claim_Amount_Requested
				Supporting_Documents_Available
				Incident_Description
				Preferred_Callback_Time
				Declaration_Of_Authenticity
				Policy_Details_Lookup
				Damage_Photo
				Repair_Estimate_Upload
				Policy_Sum_Insured_Lakhs
				FIR_Copy_Online_Link
				Accident_Scene_Video
				Incident_Voice_Statement
				Is_Third_Party_Involved
				Estimated_Repair_Cost
				Depreciation_Percent
				Net_Payable_Amount
				Claim_Process_Guidelines_Display
				Claimant_Digital_Signature
				Claim_Submitted_On
				Claim_Reference_ID
